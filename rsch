#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# rsch — RSCH Application Platform CLI
# =============================================================================
# Unified entrypoint for all project operations.
#
# Usage:
#   ./rsch prepare <app>     Clone, setup env, install deps
#   ./rsch scaffold <app>    Generate all files for a new app
#   ./rsch build <app>       Build Docker image
#   ./rsch up [--dev|--prod] Start all services
#   ./rsch down [--dev|--prod] Stop all services
#   ./rsch run-app <app>...  Start specific app(s) (siimut ikp iam lms)
#   ./rsch down-app <app>... Stop specific app(s) (-v for volumes)
#   ./rsch restart <app>     Restart a single app service
#   ./rsch exec <app> [cmd]   Exec into app container (default: sh)
#   ./rsch logs <app>        Tail logs for an app
#   ./rsch health <app>      Health check for an app
#   ./rsch infra up|down     Start/stop infrastructure only
#   ./rsch list              List available apps
#   ./rsch help              Show this help
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODE_FILE="${SCRIPT_DIR}/.rsch-mode"
DEFAULT_MODE="dev"

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}ℹ️  $1${NC}"; }
log_success() { echo -e "${GREEN}✅ $1${NC}"; }
log_warn()    { echo -e "${YELLOW}⚠️  $1${NC}"; }
log_error()   { echo -e "${RED}❌ $1${NC}"; }
log_header()  { echo -e "\n${CYAN}════════════════════════════════════════════${NC}"; echo -e "${CYAN}   $1${NC}"; echo -e "${CYAN}════════════════════════════════════════════${NC}"; }

# ──────────────────────────────────────────────
# Environment Mode Helpers
# ──────────────────────────────────────────────
# Reads/stores the active deployment mode (dev|prod) from .rsch-mode
# and resolves the corresponding env file for docker compose --env-file.

_resolve_mode() {
    local mode
    if [[ -f "$MODE_FILE" ]]; then
        mode="$(cat "$MODE_FILE" | tr -d '[:space:]')"
        if [[ "$mode" != "dev" && "$mode" != "prod" && "$mode" != "local" ]]; then
            mode="$DEFAULT_MODE"
        fi
    else
        mode="$DEFAULT_MODE"
    fi
    echo "$mode"
}

_resolve_env_file() {
    local mode
    mode="$(_resolve_mode)"
    if [[ "$mode" == "prod" ]]; then
        echo "${SCRIPT_DIR}/env/prod.env"
    elif [[ "$mode" == "local" ]]; then
        echo "${SCRIPT_DIR}/env/local.env"
    else
        echo "${SCRIPT_DIR}/env/dev.env"
    fi
}

_compose_cmd() {
    local compose_file="${1:-${SCRIPT_DIR}/compose.yml}"
    echo "docker compose --env-file $(_resolve_env_file) -f ${compose_file}"
}

show_help() {
    cat << 'EOF'
╔════════════════════════════════════════════════════════════════╗
║           RSCH Application Platform CLI                        ║
╚════════════════════════════════════════════════════════════════╝

USAGE:
    ./rsch <command> [options]

COMMANDS:

  Application Lifecycle:
    prepare <app>       Clone repo, setup .env, install dependencies
    prepare all         Prepare all apps
    scaffold <app>      Generate all files for a new app
    list                List available applications & their status
    detail <app>        Show configuration and status details of an app

  Build & Deploy:
    build <app> [push]  Build Docker image (optionally push to registry)
    build all [push]    Build all app images

  Runtime:
    up [--dev|--prod]   Start all services
    down [--dev|--prod] Stop all services
    down-all-service    Stop all apps and infrastructure
    use <dev|prod|local> Set global environment mode
    run-app <app>...    Start specific app(s) (e.g. run-app siimut ikp)
    down-app <app>...   Stop specific app(s). Add -v to remove volumes
    restart <app>       Restart a specific app service

  Infrastructure:
    infra up [svc...]   Start infrastructure (DB, MinIO, Nginx, etc)
    infra down [svc...] Stop and remove infrastructure (or specific services)
    infra stop [svc...] Stop infrastructure without removing containers
    infra restart [svc] Restart infrastructure

  Debug & Health:
    logs <app>          Show logs for a specific app
    health <app>        Run health check scripts
    exec <app> [cmd]    Exec into app container (default: sh)

  Other:
    help                Show this help message

EXAMPLES:
    ./rsch prepare siimut
    ./rsch scaffold myapp
    ./rsch build lms push
    ./rsch up --prod
    ./rsch logs siimut
    ./rsch infra up
EOF
}

# ──────────────────────────────────────────────
# Prepare
# ──────────────────────────────────────────────
cmd_prepare() {
    if [ $# -eq 0 ]; then
        "${SCRIPT_DIR}/scripts/prepare.sh"
        return
    fi
    "${SCRIPT_DIR}/scripts/prepare.sh" "$@"
}

# ──────────────────────────────────────────────
# Scaffold
# ──────────────────────────────────────────────
cmd_scaffold() {
    if [ $# -eq 0 ]; then
        "${SCRIPT_DIR}/scripts/scaffold.sh" --help
        return
    fi
    "${SCRIPT_DIR}/scripts/scaffold.sh" "$@"
}

# ──────────────────────────────────────────────
# Run App — start specific app(s) by name
# Usage: ./rsch run-app siimut ikp iam
# ──────────────────────────────────────────────
cmd_run_app() {
    if [ $# -eq 0 ]; then
        log_error "Usage: ./rsch run-app <app> [app ...]"
        echo ""
        local available_apps
        available_apps=$(ls -1 "${SCRIPT_DIR}/apps" 2>/dev/null | paste -sd, - | sed 's/,/, /g' || echo "siimut, ikp, iam, lms, smsp, rbv, fe-smsp")
        log_info "Available apps: ${available_apps}"
        log_info "Example: ./rsch run-app siimut ikp iam"
        exit 1
    fi

    local services=()
    for app in "$@"; do
        services+=("app-${app}")
        grep -q -E "^queue:\s*true" "${SCRIPT_DIR}/apps/${app}/app.yml" 2>/dev/null && services+=("queue-${app}")
        grep -q -E "^scheduler:\s*true" "${SCRIPT_DIR}/apps/${app}/app.yml" 2>/dev/null && services+=("scheduler-${app}")
        
        # Clear local and volume cache before starting
        rm -f "${SCRIPT_DIR}/site/${app}/bootstrap/cache/"*.php 2>/dev/null || true
        docker volume rm "base_${app}_bootstrap_cache" >/dev/null 2>&1 || true
    done

    log_info "Starting: $*"
    $(_compose_cmd) up -d "${services[@]}"
    log_success "Started: $*"
}

# ──────────────────────────────────────────────
# Down App — stop specific app(s), optional -v
# Usage: ./rsch down-app siimut ikp    (preserve volumes)
# Usage: ./rsch down-app siimut -v     (remove volumes)
# ──────────────────────────────────────────────
cmd_down_app() {
    if [ $# -eq 0 ]; then
        log_error "Usage: ./rsch down-app <app> [app ...] [-v]"
        echo ""
        local available_apps
        available_apps=$(ls -1 "${SCRIPT_DIR}/apps" 2>/dev/null | paste -sd, - | sed 's/,/, /g' || echo "siimut, ikp, iam, lms, smsp, rbv, fe-smsp")
        log_info "Available apps: ${available_apps}"
        log_info "Example: ./rsch down-app siimut ikp"
        log_info "         ./rsch down-app siimut -v"
        exit 1
    fi

    local apps=()
    local remove_volumes=false
    for arg in "$@"; do
        if [ "$arg" = "-v" ]; then
            remove_volumes=true
        else
            apps+=("$arg")
        fi
    done

    if [ ${#apps[@]} -eq 0 ]; then
        log_error "Usage: ./rsch down-app <app> [app ...] [-v]"
        exit 1
    fi

    local services=()
    for app in "${apps[@]}"; do
        services+=("app-${app}")
        grep -q -E "^queue:\s*true" "${SCRIPT_DIR}/apps/${app}/app.yml" 2>/dev/null && services+=("queue-${app}")
        grep -q -E "^scheduler:\s*true" "${SCRIPT_DIR}/apps/${app}/app.yml" 2>/dev/null && services+=("scheduler-${app}")
    done

    if [ "$remove_volumes" = true ]; then
        log_warn "Removing volumes for: ${apps[*]}"
        $(_compose_cmd) down -v "${services[@]}"
        log_success "Stopped and removed volumes for: ${apps[*]}"
    else
        log_info "Stopping: ${apps[*]}"
        $(_compose_cmd) down "${services[@]}"
        log_success "Stopped: ${apps[*]}"
    fi

    # Explicitly clear bootstrap cache volume and local cache files
    for app in "${apps[@]}"; do
        rm -f "${SCRIPT_DIR}/site/${app}/bootstrap/cache/"*.php 2>/dev/null || true
        docker volume rm "base_${app}_bootstrap_cache" >/dev/null 2>&1 || true
    done

    # Clear cache in web server (Nginx) by reloading it
    log_info "Clearing cache in web server (reloading Nginx)..."
    $(_compose_cmd) exec web nginx -s reload 2>/dev/null || true
    log_success "Web cache cleared."
}

# ──────────────────────────────────────────────
# Build
# ──────────────────────────────────────────────
cmd_build() {
    "${SCRIPT_DIR}/scripts/build.sh" "$@"
}

# ──────────────────────────────────────────────
# Up / Down
# ──────────────────────────────────────────────
cmd_up() {
    local mode="${1:-}"
    if [ "$mode" = "--prod" ]; then
        "${SCRIPT_DIR}/scripts/deploy.sh" up --prod
    else
        "${SCRIPT_DIR}/scripts/deploy.sh" up --dev
    fi
}

cmd_down() {
    local mode="${1:-}"
    if [ "$mode" = "--prod" ]; then
        "${SCRIPT_DIR}/scripts/deploy.sh" down --prod
    else
        "${SCRIPT_DIR}/scripts/deploy.sh" down --dev
    fi
}

# ──────────────────────────────────────────────
# Down All Service
# ──────────────────────────────────────────────
cmd_down_all_service() {
    log_info "Stopping all applications and infrastructure..."
    
    # 1. Stop applications
    $(_compose_cmd) down --remove-orphans
    
    # 2. Stop infrastructure
    $(_compose_cmd "${SCRIPT_DIR}/compose/base/infra.yml") down --remove-orphans
    
    log_success "All applications and infrastructure have been stopped."
}

# ──────────────────────────────────────────────
# Use — set global environment mode
# Usage: ./rsch use dev|prod|local
# ──────────────────────────────────────────────
cmd_use() {
    local mode="${1:-}"
    if [[ "$mode" != "dev" && "$mode" != "prod" && "$mode" != "local" ]]; then
        log_error "Usage: ./rsch use <dev|prod|local>"
        exit 1
    fi
    echo "$mode" > "$MODE_FILE"
    log_success "Mode set to: ${mode}"
    log_info "Env file: $(_resolve_env_file)"
}

# ──────────────────────────────────────────────
# Restart single app
# ──────────────────────────────────────────────
cmd_restart() {
    local app="${1:-}"
    if [ -z "$app" ]; then
        log_error "Usage: ./rsch restart <app>"
        exit 1
    fi
    local services=("app-${app}")
    grep -q -E "^queue:\s*true" "${SCRIPT_DIR}/apps/${app}/app.yml" 2>/dev/null && services+=("queue-${app}")
    grep -q -E "^scheduler:\s*true" "${SCRIPT_DIR}/apps/${app}/app.yml" 2>/dev/null && services+=("scheduler-${app}")
    
    log_info "Restarting ${services[*]}..."
    $(_compose_cmd) restart "${services[@]}"
    log_success "Restarted ${app}"

    # Clear cache in web server (Nginx) by reloading it
    log_info "Clearing cache in web server (reloading Nginx)..."
    $(_compose_cmd) exec web nginx -s reload 2>/dev/null || true
    log_success "Web cache cleared."
}

# ──────────────────────────────────────────────
# Exec — exec into app container (default: sh)
# Usage: ./rsch exec siimut
# Usage: ./rsch exec siimut bash
# ──────────────────────────────────────────────
cmd_exec() {
    local app="${1:-}"
    if [ -z "$app" ]; then
        log_error "Usage: ./rsch exec <app> [command]"
        echo ""
        local available_apps
        available_apps=$(ls -1 "${SCRIPT_DIR}/apps" 2>/dev/null | paste -sd, - | sed 's/,/, /g' || echo "siimut, ikp, iam, lms, smsp, rbv, fe-smsp")
        log_info "Available apps: ${available_apps}"
        log_info "Example: ./rsch exec siimut"
        log_info "         ./rsch exec siimut bash"
        exit 1
    fi
    shift
    local cmd="${*:-sh}"

    log_info "Exec into app-${app} with: ${cmd}"
    $(_compose_cmd) exec "app-${app}" $cmd
}

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
cmd_logs() {
    local app="${1:-}"
    if [ -z "$app" ]; then
        log_error "Usage: ./rsch logs <app>"
        exit 1
    fi
    $(_compose_cmd) logs -f --tail=100 "app-${app}" "queue-${app}"
}

# ──────────────────────────────────────────────
# Health
# ──────────────────────────────────────────────
cmd_health() {
    local app="${1:-}"
    if [ -z "$app" ]; then
        log_error "Usage: ./rsch health <app>"
        exit 1
    fi
    if [ -f "${SCRIPT_DIR}/scripts/health/check-${app}.sh" ]; then
        "${SCRIPT_DIR}/scripts/health/check-${app}.sh"
    else
        log_warn "No health script for ${app}. Checking container status..."
        $(_compose_cmd) ps "app-${app}"
    fi
}

# ──────────────────────────────────────────────
# Infrastructure
# ──────────────────────────────────────────────
cmd_infra() {
    local action="${1:-}"
    shift || true
    local compose_file="${SCRIPT_DIR}/compose/base/infra.yml"
    case "$action" in
        up)
            if [ $# -gt 0 ]; then
                log_info "Starting infrastructure services ($*) with $(_resolve_mode) env..."
                $(_compose_cmd "${compose_file}") up -d "$@"
                log_success "Infrastructure services ($*) started"
            else
                log_info "Starting infrastructure services with $(_resolve_mode) env..."
                $(_compose_cmd "${compose_file}") up -d
                log_success "Infrastructure started"
            fi
            ;;
        down)
            if [ $# -gt 0 ]; then
                log_info "Stopping and removing infrastructure services ($*)..."
                $(_compose_cmd "${compose_file}") rm -s -f -v "$@"
                log_success "Infrastructure services ($*) stopped and removed"
            else
                log_info "Stopping infrastructure services..."
                $(_compose_cmd "${compose_file}") down
                log_success "Infrastructure stopped"
            fi
            ;;
        stop)
            if [ $# -gt 0 ]; then
                log_info "Stopping infrastructure services ($*)..."
                $(_compose_cmd "${compose_file}") stop "$@"
                log_success "Infrastructure services ($*) stopped"
            else
                log_info "Stopping infrastructure services..."
                $(_compose_cmd "${compose_file}") stop
                log_success "Infrastructure stopped"
            fi
            ;;
        restart)
            if [ $# -gt 0 ]; then
                log_info "Restarting infrastructure services ($*)..."
                $(_compose_cmd "${compose_file}") restart "$@"
                log_success "Infrastructure services ($*) restarted"
            else
                log_info "Restarting infrastructure services..."
                $(_compose_cmd "${compose_file}") restart
                log_success "Infrastructure restarted"
            fi
            ;;
        *)
            log_error "Usage: ./rsch infra <up|down|stop|restart> [service...]"
            exit 1
            ;;
    esac
}

# ──────────────────────────────────────────────
# List
# ──────────────────────────────────────────────
cmd_list() {
    "${SCRIPT_DIR}/scripts/prepare.sh" list
}

# ──────────────────────────────────────────────
# Detail
# ──────────────────────────────────────────────
cmd_detail() {
    local app="${1:-}"
    if [ -z "$app" ]; then
        log_error "Usage: ./rsch detail <app>"
        exit 1
    fi
    "${SCRIPT_DIR}/scripts/prepare.sh" detail "$app"
}

# ──────────────────────────────────────────────
# Main Dispatch
# ──────────────────────────────────────────────

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    prepare)    cmd_prepare "$@" ;;
    scaffold)   cmd_scaffold "$@" ;;
    build)      cmd_build "$@" ;;
    up)         cmd_up "$@" ;;
    down)       cmd_down "$@" ;;
    down-all-service) cmd_down_all_service "$@" ;;
    use)        cmd_use "$@" ;;
    run-app)    cmd_run_app "$@" ;;
    down-app)   cmd_down_app "$@" ;;
    restart)    cmd_restart "$@" ;;
    exec)       cmd_exec "$@" ;;
    logs)       cmd_logs "$@" ;;
    health)     cmd_health "$@" ;;
    infra)      cmd_infra "$@" ;;
    list)       cmd_list ;;
    detail)     cmd_detail "$@" ;;
    help|-h|--help) show_help ;;
    *)
        log_error "Unknown command: $COMMAND"
        echo ""
        show_help
        exit 1
        ;;
esac
