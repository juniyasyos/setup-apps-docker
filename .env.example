# ===========================================
# MULTI-APPS DEPLOYMENT CONFIGURATION
# ===========================================
STACK_NAME=multi

# ===========================================
# HOST CONFIGURATION
# ===========================================
# HOST_IP=192.168.1.4
HOST_IP=192.168.1.4

# ===========================================
# APPLICATION PORTS
# ===========================================
SIIMUT_PORT=8088
IAM_PORT=7000

# ===========================================
# DOCKER REGISTRY
# ===========================================
REGISTRY=juniyasyos
VERSION=latest

# ===========================================
# DATABASE CONFIGURATION (MariaDB)
# ===========================================
DB_PORT=3306
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=siimut
MYSQL_USER=siimut
MYSQL_PASSWORD=secret

# ===========================================
# ADDITIONAL PORTS
# ===========================================
WEB_HTTP_PORT=8080
PMA_PORT=8081
REDIS_PORT=6379
VITE_PORT=5173
MAIL_WEB_PORT=8025
MAIL_SMTP_PORT=1025

# ===========================================
# APPLICATION SETTINGS
# ===========================================
USE_SSO=true
IAM_ENABLED=true
APP_ENV=production
APP_DEBUG=false

# ===========================================
# IAM SSO SHARED SECRET
# Harus sama dengan IAM_JWT_SECRET di IAM Server
# ===========================================
IAM_JWT_SECRET=change-me-to-iam-server-jwt-secret
IAM_HOST_PORT=8110

# ===========================================
# RESOURCE LIMITS
# ===========================================
# Setting resource limits based on environment:
# Local: DEPLOY_CPUS_LIMIT=1, DEPLOY_MEMORY_LIMIT=512M
# Dev:   DEPLOY_CPUS_LIMIT=2, DEPLOY_MEMORY_LIMIT=1024M
# Prod:  DEPLOY_CPUS_LIMIT=3, DEPLOY_MEMORY_LIMIT=2048M
DEPLOY_CPUS_LIMIT=1
DEPLOY_MEMORY_LIMIT=512M
