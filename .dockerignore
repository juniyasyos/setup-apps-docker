# ============================================================
# Generic Docker Ignore - Multi Laravel Apps
# Build context: rsch-apps root
# Apps path    : site/<app>
# ============================================================

# ------------------------------------------------------------
# Version Control
# ------------------------------------------------------------
.git
.gitignore
.gitattributes
.gitmodules
.github/
.gitlab/
.gitlab-ci.yml

# ------------------------------------------------------------
# Environment & Secrets
# ------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.production
.env.staging

# ------------------------------------------------------------
# Docker Compose / Local Ops
# ------------------------------------------------------------
docker-compose*.yml
compose.override.yml
*.override.yml

# Jangan ignore Dockerfile kalau dipakai build
# Dockerfile*
# .dockerignore

# ------------------------------------------------------------
# OS / Editor
# ------------------------------------------------------------
.DS_Store
Thumbs.db
.swp
.swo
*~
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------
# Logs / Temp / Cache Global
# ------------------------------------------------------------
*.log
*.bak
*.tmp
.cache/
tmp/
temp/
**/tmp/
**/temp/

# ------------------------------------------------------------
# Node / Frontend Build Artifacts
# ------------------------------------------------------------
node_modules/
**/node_modules/

.npm/
.pnpm-store/
.yarn/
.yarn-cache/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
# build/
**/dist/
# **/build/

# Kalau Laravel/Vite build public/build ingin dibuat di image,
# jangan copy dari host. Build ulang di Dockerfile kalau perlu.
# **/public/build/
# **/public/hot

# ------------------------------------------------------------
# PHP / Composer
# ------------------------------------------------------------
vendor/

composer.phar
auth.json

# ------------------------------------------------------------
# Laravel Runtime Files
# ------------------------------------------------------------
**/storage/logs/*
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/views/*
**/storage/framework/testing/*
**/bootstrap/cache/*.php

# Biasanya upload user jangan masuk image
**/storage/app/public/*
**/storage/app/private/*
**/storage/app/uploads/*
**/storage/app/backups/*
**/storage/backups/*
**/backups/

# Keep directory placeholder kalau ada
!**/.gitkeep

# ------------------------------------------------------------
# Testing
# ------------------------------------------------------------
tests/
**/tests/
phpunit.xml
phpunit.xml.dist
pest.php
*.test.js
*.spec.js
test-*.php

# ------------------------------------------------------------
# Documentation
# ------------------------------------------------------------
README*.md
CHANGELOG*.md
*.md
docs/
**/docs/

# ------------------------------------------------------------
# Archives / Dumps / Database
# ------------------------------------------------------------
*.sql
*.sqlite
*.sqlite3
*.db
*.dump

*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.rar
*.7z

# ------------------------------------------------------------
# Reports / Debug / Local Scripts
# ------------------------------------------------------------
debug-*.php
debug-*.sh
diagnose-*.sh
verify-*.sh
prepare-*.sh
analyze-*.php
*-report.*
*-REPORT.*
TESTING-*.md
VERIFICATION-*.md

# ------------------------------------------------------------
# Multi App Source
# ------------------------------------------------------------
# Jangan pakai whitelist agresif seperti:
# *
# !site/**
#
# Karena project ini multi-app dan APP_DIR ditentukan oleh Dockerfile.
# Biarkan site tersedia, tapi folder berat di dalamnya sudah di-ignore oleh rule ** di atas.